---
import { renderCategoryPage } from "../../src/render.js";
import { ensureCatalog } from "../lib.js";
interface Props { catalog: unknown; slug: string; tabs?: boolean; cardStyle?: "arch" | "rounded" | "flat"; reveal?: boolean }
const { catalog: raw, slug, ...opts } = Astro.props;
---
<div class="ve-shop"><Fragment set:html={renderCategoryPage(ensureCatalog(raw), slug, opts)} /></div>
