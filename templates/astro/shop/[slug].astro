---
// One page per category and per product. Generated by `npx ve-backend init`.
import Layout from "ve-backend/astro/components/DefaultLayout.astro";
import { VeHead, CategoryPage, ProductPage, ensureCatalog, getShopPaths, findCategory, findProduct } from "ve-backend/astro";
import raw from "__CATALOG__";
export function getStaticPaths() {
  return getShopPaths(ensureCatalog(raw));
}
const catalog = ensureCatalog(raw);
const { kind, slug } = Astro.props;
const category = kind === "category" ? findCategory(catalog, slug) : null;
const product = kind === "product" ? findProduct(catalog, slug) : null;
---
<Layout title={`${(category ?? product).name} | ${catalog.company.name}`} description={category?.description ?? product?.tagline ?? ""}>
  <VeHead catalog={catalog} />
  <div class="ve-page">
    {category && (
      <>
        <header class="ve-page-head">
          {category.eyebrow && <p class="ve-eyebrow">{category.eyebrow}</p>}
          <h1>{category.title || category.name}</h1>
          {category.description && <p class="ve-page-intro">{category.description}</p>}
        </header>
        <CategoryPage catalog={catalog} slug={slug} />
      </>
    )}
    {product && <ProductPage catalog={catalog} slug={slug} />}
  </div>
</Layout>
