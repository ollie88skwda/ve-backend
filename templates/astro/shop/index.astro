---
// Generated by `npx ve-backend init`. Swap DefaultLayout for your site's layout.
import Layout from "ve-backend/astro/components/DefaultLayout.astro";
import { VeHead, ShopIndex } from "ve-backend/astro";
import catalog from "__CATALOG__";
---
<Layout title={`${catalog.shop.title} | ${catalog.company.name}`} description={catalog.shop.intro}>
  <VeHead catalog={catalog} />
  <div class="ve-page">
    <header class="ve-page-head"><h1>{catalog.shop.title}</h1><p class="ve-page-intro">{catalog.shop.intro}</p></header>
    <ShopIndex catalog={catalog} />
  </div>
</Layout>
